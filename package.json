{
  "name": "claim-check",
  "version": "0.1.0",
  "private": true,
  "description": "Checks every factual claim in an AI-written draft against confirmed facts, and lets a human sign off.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "check": "tsx --env-file=.env cli.ts check",
    "review": "tsx --env-file=.env cli.ts review",
    "facts": "tsx --env-file=.env cli.ts facts",
    "evals": "tsx --env-file=.env evals/run.ts",
    "compare": "tsx evals/compare.ts",
    "fever": "tsx --env-file=.env evals/fever.ts",
    "dataset": "tsx --env-file=.env evals/load-dataset.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "mastra dev"
  },
  "dependencies": {
    "@mastra/core": "^1.82.0",
    "@mastra/libsql": "^1.29.0",
    "@mastra/memory": "^1.41.0",
    "@mastra/observability": "^1.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "mastra": "^1.38.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
